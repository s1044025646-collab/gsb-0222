{
  "name": "flashcards-srs",
  "version": "1.0.0",
  "description": "本地闪卡间隔复习后端（API + CLI，TypeScript + Node.js + SQLite）",
  "type": "module",
  "bin": {
    "flashcards": "dist/cli.js"
  },
